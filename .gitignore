node_modules/

# Build output. `action/dist/` is deliberately NOT ignored: a JavaScript
# GitHub Action runs whatever is committed at the tag a workflow pins, so the
# bundle must be in the repository. CI fails if it is out of date.
/dist/
coverage/
*.tsbuildinfo

.DS_Store

.env
.env.*
!.env.example
# Fixture environment files are synthetic and must be committed so the
# committed-env-file rule has a positive fixture. See fixtures/README.md.
!fixtures/**/.env
!fixtures/**/.env.*

.vitest-temp/
bench/results/
*.tgz
shipcheck.sarif

# Scratch directories used by the package-integrity workflow.
/.pack/
/consumer/

# Third-party corpus clones live outside the repository (see scripts/corpus.mjs).
# Nothing under corpus/ except the pinned list and the generated results is tracked.
corpus/cache/
# The full machine-readable result is ~1 MB and is regenerated byte-for-byte
# from the pinned commits in corpus/corpus.json. The committed evidence is
# corpus/results/SUMMARY.md and corpus/TRIAGE.md.
corpus/results/latest.json
